<%= simple_form_for([@item, @task]) do |form| %>
  <%= form.input :titel %>
  <%= form.input :content %>
  <%= form.input :done %>

  <%= link_to @index_url, class: "btn btn-primary" do %>
    <i class="fas fa-arrow-left"></i>
    Zurück
  <% end %>
  <%= content_tag :button, class: "btn btn-primary", type: "submit" do %>
    <i class="fas fa-save"></i>
    Speichern
  <% end %>
<% end %>
